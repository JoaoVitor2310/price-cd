{
	"name": "price-researcher",
	"version": "1.0.0",
	"description": "",
	"main": "src/server.ts",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"dev:nest": "node --import @swc-node/register/esm-register --watch src/main.ts",
		"prod": "xvfb-run node index.js",
		"build": "tsc && tsc-alias",
		"start": "npm run build && node dist/server.js",
		"start:nest": "npm run build && node dist/main.js",
		"lint": "biome check .",
		"lint:fix": "biome check . --write --unsafe",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@nestjs/common": "^12.0.4",
		"@nestjs/config": "^12.0.0",
		"@nestjs/core": "^12.0.4",
		"@nestjs/platform-express": "^12.0.4",
		"@nestjs/schedule": "^12.0.2",
		"cheerio": "^1.0.0",
		"dotenv": "^17.2.2",
		"express": "^5.1.0",
		"puppeteer": "^24.22.2",
		"puppeteer-extra": "^3.3.6",
		"puppeteer-extra-plugin-adblocker": "^2.13.6",
		"puppeteer-extra-plugin-anonymize-ua": "^2.4.6",
		"puppeteer-extra-plugin-stealth": "^2.11.2",
		"puppeteer-real-browser": "^1.4.4",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^4.1.11"
	},
	"pkg": {
		"assets": [
			"node_modules/puppeteer/**/*",
			"node_modules/vm2/**/*"
		],
		"targets": [
			"node18-macos-arm64",
			"node18-win-arm64"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@nestjs/testing": "^12.0.4",
		"@swc-node/register": "^1.12.1",
		"@swc/core": "^1.16.2",
		"@types/cheerio": "^0.22.35",
		"@types/express": "^5.0.0",
		"@types/node": "^20.13.0",
		"@types/supertest": "^7.2.0",
		"nodemon": "^3.1.9",
		"supertest": "^7.2.2",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"tsc-alias": "^1.8.16",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3",
		"unplugin-swc": "^2.0.0",
		"vitest": "^3.2.4"
	}
}
