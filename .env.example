# ── Ambiente ───────────────────────────────────────────────────────────────────
# development | production | test (default development). Em production o boot
# exige STEAMTRADES_SESSION, SISTEMA_ESTOQUE_URL e EXTERNAL_SECRET.
NODE_ENV=
# "true" quando rodando dentro do container.
DOCKER=

# ── Servidor ───────────────────────────────────────────────────────────────────
# Porta em que o app escuta (default 5555). No Docker o compose fixa 5555 e
# ignora este valor — a porta do host se escolhe com HOST_PORT/HOST_PORT_DEV.
PORT=5555
# Timeout do HTTP server, em ms (default 600000 = 10min).
SERVER_TIMEOUT_MS=
# Timeout de navegação do Puppeteer, em ms (default 3000).
TIMEOUT=
# Teto do encerramento ordenado do Chromium (browser.close()), em ms (default 15000).
# Passou disso, o cleanup parte para SIGTERM/SIGKILL na árvore de processos.
BROWSER_CLOSE_TIMEOUT_MS=
# Janela entre o SIGTERM e o SIGKILL no cleanup do Chromium, em ms (default 3000).
BROWSER_KILL_GRACE_MS=
# Idade máxima da sessão compartilhada do AllKeyShop, em ms (default 1800000 = 30min).
# Reciclar evita que um Chromium de horas acumule memória. 0 desliga a reciclagem.
BROWSER_SESSION_MAX_AGE_MS=
# Teto para resolver o desafio da Cloudflare, em ms (default 45000).
CLOUDFLARE_CHALLENGE_TIMEOUT_MS=
# Diretório onde gravar HTML + screenshot quando o desafio falha. Vazio = não grava.
CLOUDFLARE_DEBUG_DIR=

# ── Autenticação ───────────────────────────────────────────────────────────────
# Cookie PHPSESSID de uma sessão logada no SteamTrades. Obrigatório para bump,
# reabastecimento e descoberta de fornecedores.
STEAMTRADES_SESSION=
# Segredo exigido no header das rotas chamadas pelo Sistema Estoque.
INTERNAL_SECRET=
# Segredo enviado por nós ao chamar o Sistema Estoque.
EXTERNAL_SECRET=

# ── Integrações ────────────────────────────────────────────────────────────────
SISTEMA_ESTOQUE_URL=
API_KEY_GAMIVO=

# ── Cache de preço (Redis) ─────────────────────────────────────────────────────
# Vazio = sem cache. No Docker NÃO preencha aqui: o docker-compose.yml aponta
# produção e dev cada um para o seu Redis. Só para rodar fora do Docker.
REDIS_URL=
# Validade de um preço no cache, em segundos (default: 3600).
PRICE_CACHE_TTL_SECONDS=

# ── Fila da pesquisa (Redis, ADR 0009) ─────────────────────────────────────────
# No Docker é o mesmo Redis do cache, no banco 1 (o cache fica no 0) — ele precisa
# de AOF e `noeviction`, a configuração do docker-compose.yml. Obrigatória em
# produção. Vazio = fila em memória (só dev/teste: um restart perde os pedidos).
# No Docker NÃO preencha aqui: o docker-compose.yml aponta cada um para o seu Redis.
QUEUE_REDIS_URL=

# ── Webhook do resultado da pesquisa (ADR 0010) ─────────────────────────────────
# Hosts que podem receber o webhook (`webhook_url` de POST /api/games/research),
# separados por vírgula. Só o host, sem porta nem caminho: "chatbot" casa com
# http://chatbot:3000/... Vazio = nenhum webhook é aceito (a requisição recebe 400).
WEBHOOK_ALLOWED_HOSTS=
# Segredo da assinatura HMAC-SHA256 do webhook, no mínimo 32 caracteres. Não é
# enviado: quem recebe guarda o mesmo valor e confere a assinatura. Obrigatório
# quando WEBHOOK_ALLOWED_HOSTS tem algum host. Gere com: openssl rand -hex 32
WEBHOOK_SIGNING_SECRET=

# ── Painel das filas (ADR 0011) ────────────────────────────────────────────────
# Usuário e senha do Bull Board em /api/admin/queues (Basic Auth, somente leitura).
# Os dois juntos, ou nenhum: vazios, o painel não existe (404). Também precisa da
# QUEUE_REDIS_URL. Senha com no mínimo 16 caracteres: openssl rand -hex 16
QUEUE_DASHBOARD_USER=
QUEUE_DASHBOARD_PASSWORD=

# ── SteamTrades ────────────────────────────────────────────────────────────────
# Steam ID da conta do CarcaDeals — usado pelo scheduler de bump dos nossos anúncios.
STEAM_ID=
# "false" desliga o agendador de bump (default: ligado). Dois processos com o
# agendador ligado comentam no SteamTrades com a mesma conta — risco de ban.
# Se subir uma segunda instância (dev junto da produção, por exemplo), desligue
# o agendador nela.
BUMP_SCHEDULER_ENABLED=
# Steam IDs a NUNCA abordar na descoberta de fornecedores.
# Aceita vários, separados por vírgula (espaços em volta são ignorados):
#   USER_TO_IGNORE=76561199999999999,76561198888888888
USER_TO_IGNORE=
# Pausa entre page loads no SteamTrades, em ms. Vazio = sem pausa.
STEAMTRADES_PAGE_DELAY_MS=

# ── Agendamento e concorrência ─────────────────────────────────────────────────
# Execuções simultâneas de POST /api/lists/run (default 1).
RUN_LISTS_CONCURRENCY=
# Listas ativas processadas por fornecedor (default 3).
MAX_ACTIVE_LISTS=
# SEM EFEITO hoje: nenhum código lê esta variável. A descoberta de fornecedores roda sob
# comando manual (POST /api/suppliers/find-new), não por intervalo. Ver docs/IMPROVEMENTS.md.
NEW_SUPPLIERS_INTERVAL_HOURS=

# ── Ambiente ───────────────────────────────────────────────────────────────────
# "true" quando o Xvfb já é iniciado por fora (Docker via xvfb-run).
USE_EXTERNAL_XVFB=
